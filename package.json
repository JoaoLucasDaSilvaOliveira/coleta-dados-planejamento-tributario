{
  "name": "contabiehl-planejamento-tributario",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:db": "npx --yes supabase@2.116.0 test db",
    "test:functions": "npx --yes deno@2.9.6 test --allow-env --allow-net supabase/functions/tests/security_test.ts supabase/functions/tests/public_form_test.ts supabase/functions/tests/manage_expense_item_test.ts supabase/functions/tests/internal_submission_test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "generate:types": "node scripts/generate-types.mjs",
    "bootstrap": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "@supabase/supabase-js": "2.55.0",
    "pinia": "3.0.3",
    "vue": "3.5.18",
    "vue-router": "4.5.1",
    "vuetify": "3.8.12",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "22.15.21",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "autoprefixer": "10.4.21",
    "eslint": "9.33.0",
    "eslint-plugin-vue": "10.4.0",
    "jsdom": "26.1.0",
    "postcss": "^8.5.26",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "typescript-eslint": "8.39.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "2.2.12"
  }
}
